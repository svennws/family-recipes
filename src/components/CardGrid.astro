---
const hasChildren = Astro.slots.has('default');
---

{hasChildren && (
	<ul class="card-grid">
		<slot />
	</ul>
)}

<style>
	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	:global(.card-grid__item) {
		min-height: 140px;
		background: linear-gradient(180deg, #fff 0%, #f5fbf7 100%);
		border-radius: 14px;
		border: 1px solid rgba(var(--black), 0.08);
		box-shadow: 0 12px 28px rgba(var(--black), 0.04);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}

	:global(.card-grid__link) {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		height: 100%;
		padding: 1.1rem 1.25rem;
		text-decoration: none;
		color: inherit;
		transition: color 0.2s ease;
		gap: 0.35rem;
	}

	:global(.card-grid__title) {
		margin: 0;
		color: rgb(var(--black));
		line-height: 1.25;
		font-size: 1.25rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	:global(.card-grid__meta) {
		margin: 0;
		color: rgb(var(--gray));
		text-align: left;
		font-size: 0.97rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	:global(.card-grid__item:hover) {
		transform: translateY(-6px) scale(1.01);
		border-color: rgba(var(--accent-rgb), 0.28);
		box-shadow: 0 18px 42px rgba(var(--black), 0.08);
	}

	:global(.card-grid__link:hover .card-grid__title),
	:global(.card-grid__link:hover .card-grid__meta) {
		color: rgb(var(--accent));
	}

	:global(.card-grid__link:focus-visible) {
		outline: 3px solid rgba(var(--accent-rgb), 0.35);
		outline-offset: 6px;
		border-radius: 12px;
	}

	@media (max-width: 720px) {
		.card-grid {
			gap: 1rem;
		}
	}
</style>
