---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

	<header>
		<nav>
			<h2>
				<a class="brand-link" href="/">
					<img src="/logo.svg" alt={`${SITE_TITLE} logo`} class="site-logo" />
					{SITE_TITLE}
				</a>
			</h2>
			<div class="internal-links">
				<HeaderLink href="/">Forsiden</HeaderLink>
				<HeaderLink href="/about">Om siden</HeaderLink>
				<HeaderLink href="/new-recipe">Ny oppskrift</HeaderLink>
			</div>
		</nav>
	</header>
<style>
	header {
		margin: 0;
		padding: 0.5rem 1.5rem;
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgba(var(--black), 0.05);
		position: sticky;
		top: 0;
		z-index: 10;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(1200px, 100%);
		margin: 0 auto;
		padding: 0.25rem 0;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.internal-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}
	.internal-links a {
		padding: 0.75em 1em;
		color: rgb(var(--black));
		border: 1px solid transparent;
		border-radius: 999px;
		text-decoration: none;
		transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
	}
	.site-logo {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		border: 1px solid rgba(var(--black), 0.06);
		box-shadow: 0 10px 30px rgba(var(--black), 0.05);
	}
	h2 {
		margin: 0;
		font-size: 1rem;
		flex: 1;
	}
	.brand-link,
	.brand-link.active {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		color: inherit;
		padding: 0.5rem 0;
		font-weight: 700;
	}
	.brand-link:hover {
		background: transparent;
		color: inherit;
		border-color: transparent;
	}
	.internal-links a.active {
		color: var(--accent);
		background: rgba(var(--accent-rgb), 0.1);
		border-color: rgba(var(--accent-rgb), 0.2);
	}
	.internal-links a:hover {
		background: rgba(var(--accent-rgb), 0.08);
		color: var(--accent);
	}
	.internal-links a:focus-visible {
		outline: 3px solid rgba(var(--accent-rgb), 0.35);
		outline-offset: 2px;
	}
	@media (max-width: 640px) {
		nav {
			flex-direction: column;
			align-items: center;
			justify-content: center;
			padding: 0.25rem 0;
		}
		h2 {
			position: static;
			transform: none;
			margin: 0 0 0.25rem;
		}
		.internal-links {
			width: 100%;
			justify-content: center;
			gap: 1rem;
		}
		.internal-links a,
		.internal-links a.active {
			width: 100%;
			text-align: center;
		}
	}
</style>
