---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<html lang="no">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<BaseHead
			title={`Om ${SITE_TITLE}`}
			description={`Lær mer om ${SITE_TITLE}, hvordan nettstedet er laget og hvordan du kan bidra.`}
		/>
		<style>
			.about-shell {
				width: min(960px, 100%);
				margin: 0 auto;
				padding: 2.5rem 1.5rem 4rem;
				color: rgb(var(--gray-dark));
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
			}
			.hero {
				border-radius: 22px;
				border: 1px solid rgba(var(--black), 0.08);
				background:
					radial-gradient(circle at 20% 20%, rgba(var(--accent-rgb), 0.12), transparent 35%),
					radial-gradient(circle at 80% 0%, rgba(var(--gray-light), 0.8), transparent 30%),
					#fff;
				padding: 2.6rem 2.8rem;
				box-shadow: 0 20px 50px rgba(var(--black), 0.04);
			}
			.eyebrow {
				margin: 0 0 0.4rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				font-weight: 700;
				font-size: 0.78rem;
				color: rgba(var(--black), 0.65);
			}
			.hero h1 {
				margin: 0 0 0.5rem;
				font-size: clamp(2rem, 3.5vw, 2.6rem);
				line-height: 1.15;
			}
			.hero-lede {
				margin: 0 0 1.2rem;
				color: rgb(var(--gray));
				line-height: 1.6;
			}
			.hero-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem 1rem;
				align-items: center;
				color: rgb(var(--black));
				font-weight: 700;
			}
			.card {
				background: #fff;
				border-radius: 18px;
				border: 1px solid rgba(var(--black), 0.06);
				box-shadow: 0 18px 50px rgba(var(--black), 0.03);
				padding: 1.75rem 2rem;
			}
			.card h2 {
				margin: 0 0 0.5rem;
			}
			p {
				margin: 0 0 1rem;
				line-height: 1.6;
			}
			ul {
				margin: 0;
				padding-left: 1.25rem;
				line-height: 1.6;
			}
			@media (max-width: 720px) {
				.about-shell {
					padding: 1.75rem 1.1rem 3rem;
					gap: 2rem;
				}
				.hero {
					padding: 2.2rem 1.4rem;
				}
				.card {
					padding: 1.5rem 1.35rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="about-shell">
			<section class="hero">
				<p class="eyebrow">Om siden</p>
				<h1>{SITE_TITLE}</h1>
				<p class="hero-lede">
					Dette prosjektet er et forsøk på å flytte oppskriftene fra papir og notatbøker til noe
					som er lett å finne tilbake til og dele, uten løpende drift. Løsningen er i praksis
					gratis å drifte og krever ingen servere eller kode som må oppdateres.
				</p>
			</section>

			<section class="card">
				<h2>Hvordan er den laget?</h2>
				<p>
					Siden er laget i Astro og genererer statiske HTML-sider. Alle oppskrifter ligger som
					JSON i repoet, så innholdet lever sammen med koden og kan versjoneres.
				</p>
			</section>

			<section class="card">
				<h2>Hvordan kan du bidra</h2>
				<p>
					Familiemedlemmer kan legge til nye oppskrifter via GitHub etter å ha fått tilgang.
					Er du i familien, ta kontakt med Svenn.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
